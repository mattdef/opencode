{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "*": "allow",
  },
  "model": "opencode-go/mimo-v2.5-pro",
  "default_agent": "build",
  "instructions": ["./prompts/general-guideline.md"],
  "experimental": {
    "disable_paste_summary": true,
  },
  "agent": {
    "build": {
      "description": "Primary coding agent that delegates command execution to @executor",
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "permission": {
        "bash": "deny",
      },
      "prompt": "{file:./prompts/coding-guideline.md}",
    },
    "plan": {
      "description": "Structured implementation planning",
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "prompt": "{file:./prompts/plan-guideline.md}",
    },
    "OneShoot": {
      "description": "Coordination-only agent that delegates planning, coding, validation, and review to dedicated subagents (@oneshoot-plan, @oneshoot-build, @executor, @oneshoot-review). NEVER implements, plans, or codes directly.",
      "model": "opencode-go/mimo-v2.5",
      "variant": "high",
      "permission": {
        "bash": "deny",
        "task": {
          "*": "deny",
          "oneshoot-plan": "allow",
          "oneshoot-build": "allow",
          "oneshoot-review": "allow",
          "explore": "allow",
          "executor": "allow",
          "designer": "allow",
        },
      },
      "prompt": "{file:./prompts/oneshoot-guideline.md}",
    },
    "oneshoot-plan": {
      "description": "Planning subagent for the OneShoot workflow that creates implementation plans with its own tools and asks its caller to coordinate any extra execution or design work",
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "task": "deny",
      },
      "prompt": "{file:./prompts/oneshoot-plan-guideline.md}",
    },
    "oneshoot-build": {
      "description": "Coding subagent for the OneShoot workflow that edits files directly and asks its caller to coordinate validation via @executor",
      "model": "openai/gpt-5.4-mini",
      "variant": "xhigh",
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "task": "deny",
      },
      "prompt": "{file:./prompts/oneshoot-build-guideline.md}",
    },
    "oneshoot-review": {
      "description": "Review subagent for the OneShoot workflow that writes findings to .opencode/review.md and asks its caller to coordinate any extra validation or design review",
      "model": "openai/gpt-5.4",
      "variant": "xhigh",
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "task": "deny",
      },
      "prompt": "{file:./prompts/oneshoot-review-guideline.md}",
    },
    "explore": {
      "description": "Fast codebase exploration",
      "model": "opencode-go/mimo-v2.5",
      "variant": "max",
      "permission": {
        "task": "deny",
      },
      "prompt": "{file:./prompts/explore-guideline.md}",
    },
    "reviewer": {
      "description": "Automated review agent",
      "model": "opencode-go/deepseek-v4-pro",
      "mode": "all",
      "prompt": "Use code-review skill",
    },
    "executor": {
      "description": "Default execution subagent for bash commands, tests, builds, and validation",
      "model": "opencode-go/mimo-v2.5-pro",
      "mode": "subagent",
      "permission": {
        "task": "deny",
      },
      "prompt": "{file:./prompts/executor-guideline.md}",
    },
    "designer": {
      "description": "Specialized UX design agent for web, mobile, and desktop applications",
      "model": "opencode-go/minimax-m3",
      "variant": "high",
      "mode": "subagent",
      "permission": {
        "task": "deny",
      },
      "prompt": "{file:./prompts/designer-guideline.md}",
    },
    "trading": {
      "description": "Expert trading agent specialized in scalping, ICT/SMC concepts, and market analysis",
      "model": "opencode-go/minimax-m3",
      "variant": "high",
      "mode": "all",
      "prompt": "{file:./prompts/trading-guideline.md}",
    },
  },
  "plugin": ["opencode-agent-skills", "opencode-ntfy.sh"],
  "mcp": {
    "tradingview": {
      "type": "local",
      "command": ["node", "/home/matt/GitHub/tradingview-mcp/src/server.js"],
      "enabled": true,
    },
  },
}
